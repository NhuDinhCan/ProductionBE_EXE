# Copy this file to .env for local development.
# Never commit .env files that contain real secrets.

SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/exe?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_unicode_ci
DB_USERNAME=root
DB_PASSWORD=change_me_for_local_dev

# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_random_string_at_least_64_characters_long

ALLOWED_ORIGINS=http://localhost:5173
REDIS_HOST=localhost
REDIS_PORT=6379
SWAGGER_ENABLED=true

AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=deepseek/deepseek-chat-v3-0324:free
AI_API_KEY=replace_with_openrouter_api_key
AI_TIMEOUT_SECONDS=60
AI_RATE_LIMIT_PER_MINUTE=20

# Local development can keep the in-memory simple broker.
WEBSOCKET_BROKER_RELAY_ENABLED=false
