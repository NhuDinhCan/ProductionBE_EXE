# Copy this file to .env for local development.
# Never commit .env files that contain real secrets.

SERVER_PORT=8080
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=exe;encrypt=false;trustServerCertificate=true;sendStringParametersAsUnicode=true
DB_USERNAME=sa
DB_PASSWORD=change_me_for_local_dev

# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_random_string_at_least_64_characters_long

ALLOWED_ORIGINS=http://localhost:5173
REDIS_HOST=localhost
REDIS_PORT=6379
SWAGGER_ENABLED=true

# Local development can keep the in-memory simple broker.
WEBSOCKET_BROKER_RELAY_ENABLED=false
