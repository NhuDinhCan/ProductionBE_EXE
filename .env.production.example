# Copy this file to .env.production on the production host.
# Fill every placeholder with real production values. Do not commit .env.production.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_PORT=8080
WEB_PORT=80

# Require encrypted SQL Server connections in production.
# Example for a normal SQL Server host:
DB_URL=jdbc:sqlserver://db.example.com:1433;databaseName=exe;encrypt=true;trustServerCertificate=false;sendStringParametersAsUnicode=true
DB_USERNAME=production_user
DB_PASSWORD=replace_with_strong_database_password

# Generate with: openssl rand -base64 64
JWT_SECRET=replace_with_random_string_at_least_64_characters_long

# Comma-separated frontend origins. Do not use * in production.
ALLOWED_ORIGINS=https://app.example.com

# Frontend build-time URLs. Use the public API origin that browsers can reach.
VITE_API_BASE_URL=https://api.example.com/api
VITE_WS_URL=https://api.example.com/ws

REDIS_HOST=redis.example.com
REDIS_PORT=6379
# If Redis requires auth, set it as a container env var:
# SPRING_DATA_REDIS_PASSWORD=replace_with_redis_password

# RabbitMQ STOMP broker for production realtime chat.
# This keeps 1-1 chat working correctly when API is scaled to multiple instances.
RABBITMQ_DEFAULT_USER=stomp_app
RABBITMQ_DEFAULT_PASS=replace_with_strong_rabbitmq_password
WEBSOCKET_BROKER_RELAY_ENABLED=true
WEBSOCKET_BROKER_RELAY_HOST=rabbitmq
WEBSOCKET_BROKER_RELAY_PORT=61613
WEBSOCKET_BROKER_RELAY_CLIENT_LOGIN=stomp_app
WEBSOCKET_BROKER_RELAY_CLIENT_PASSCODE=replace_with_strong_rabbitmq_password
WEBSOCKET_BROKER_RELAY_SYSTEM_LOGIN=stomp_app
WEBSOCKET_BROKER_RELAY_SYSTEM_PASSCODE=replace_with_strong_rabbitmq_password
WEBSOCKET_BROKER_RELAY_VIRTUAL_HOST=/

SWAGGER_ENABLED=false

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
TOMCAT_MAX_THREADS=200
TOMCAT_MIN_SPARE_THREADS=10
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_SECURITY=WARN
